          },
          {
            "text": "Other",
            "value": "Other"
          }
        ]
      },
      {
        "id": 6,
        "type": "text",
        "label": "Other dietary need",
        "isRequired": true,
        "conditionalLogic": {
          "actionType": "show",
          "logicType": "any",
          "rules": [
            {
              "fieldId": "5",
              "operator": "is",
              "value": "Other"
            }
          ]
        }
      },
      {
        "id": 7,
        "type": "text",
