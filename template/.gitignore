node_modules/
dist/
.astro/
.wrangler/
.env
.env.*
.DS_Store
media/archive/
.dev.vars
.dev.vars.*
# ...but the example must ship. The real one never does.
!.dev.vars.example

# Generated from docs/handover.md by `npm run handover`. The markdown is the
# source; a committed PDF goes stale the moment the markdown changes and there
# is no way to tell by looking.
docs/*.pdf

# Written by `npm run shots`. PNGs of every route at two widths — heavy, and
# regenerable from the live sites right up until the old one goes away. The
# pairs belong WITH the handover deliverables, not in the site's history.
shots/

# og-cards.mjs working directory. Removed on a successful run; left behind
# by a crash, which is exactly when you do not want it committed.
.og-tmp/
.md-pdf.*.html

# Written by `npm run recon` — the old site's inventory. Commit it deliberately
# if you want the migration's starting state in history; it is not build output.
# recon/

# `npm run design`'s per-page-and-width capture cache. Never history, even
# when recon/ is: it is a cache, re-measured with --refresh.
recon/.cache/

# What the old site's owner hands over: a backup, exports, original images.
# `npm run recon` creates the folder and recon/ask-client.md tells them to put
# everything here. ⚠ A backup carries the config file (database password,
# cookie-signing secrets) and the users table — it is never committed, and it is
# deleted at handover. recon refuses to create the folder if this line is missing.
client-files/

# The same files dropped anywhere else in the project. `recon/` is meant to be
# committed, so it is the likely wrong place. A belt, not the plan.
*.wpress
*.sql
*.sql.gz
*.sql.zip
